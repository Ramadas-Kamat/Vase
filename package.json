{
  "name": "digital-flower-vase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive digital flower vase — customise the vase, arrange the flowers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run typecheck:worker && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.0"
  }
}
